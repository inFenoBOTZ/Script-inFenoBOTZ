-- ==========================================
-- FEATURE: SIDE DASH (TOGGLE)
-- ==========================================
local function dash(direction)
    if not dashEnabled or dashCooldown or not RootPart then return end
    dashCooldown = true
    
    local camera = workspace.CurrentCamera
    local dashVelocity = Vector3.new(0,0,0)
    
    if direction == "Left" then
        dashVelocity = -camera.CFrame.RightVector * dashForce
    elseif direction == "Right" then
        dashVelocity = camera.CFrame.RightVector * dashForce
    end
    
    local BV = Instance.new("BodyVelocity")
    BV.maxForce = Vector3.new(1e5, 0, 1e5) -- Hanya gerak horizontal
    BV.velocity = dashVelocity
    BV.Parent = RootPart
    
    task.wait(0.15) -- Durasi dash
    BV:Destroy()
    
    task.wait(0.8) -- Cooldown dash (0.8 detik)
    dashCooldown = false
end

Tabs.Movement:AddToggle("DashToggle", {
    Title = "Enable Side Dash",
    Description = "Aktifkan dash tombol Q (Kiri) & E (Kanan)",
    Default = false,
    Callback = function(Value)
        dashEnabled = Value
    end
})

-- Deteksi Keyboard untuk Dash (Hanya jalan saat Toggle bernilai TRUE)
game:GetService("UserInputService").InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not dashEnabled then return end
    
    if input.KeyCode == Enum.KeyCode.Q then
        dash("Left")
    elseif input.KeyCode == Enum.KeyCode.E then
        dash("Right")
    end
end)


