ActionBtn.Parent = Sidebar


-- --- 2. LOGIKA & FITUR INTERAKSI ---
local isMinimized = false
local isLeft = true
local isDepan = true
local actionAktif = false

-- Fungsi Toggle Minimize (Menyembunyikan / Membuka Menu)
ToggleBtn.MouseButton1Click:Connect(function()
	isMinimized = not isMinimized
	local targetX = 0
	
	if isMinimized then
		targetX = isLeft and -240 or 240
		ToggleBtn.Text = (isLeft and ">" or "<")
	else
		targetX = 0
		ToggleBtn.Text = (isLeft and "<" or ">")
	end
	
	local targetPos = isLeft and UDim2.new(0, targetX, 0, 0) or UDim2.new(1, targetX - 240, 0, 0)
	TweenService:Create(Sidebar, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = targetPos}):Play()
end)

-- Fungsi Pindah Posisi Kanan / Kiri
PositionBtn.MouseButton1Click:Connect(function()
	isLeft = not isLeft
	isMinimized = false
	
	if isLeft then
		Sidebar.Position = UDim2.new(0, 0, 0, 0)
		ToggleBtn.Position = UDim2.new(1, 10, 0, 20)
		ToggleBtn.Text = "<"
		PositionBtn.Text = "Posisi: Samping Kiri"
	else
		Sidebar.Position = UDim2.new(1, -240, 0, 0)
		ToggleBtn.Position = UDim2.new(0, -45, 0, 20) -- Tombol pindah ke sisi kiri luar frame
		ToggleBtn.Text = ">"
		PositionBtn.Text = "Posisi: Samping Kanan"
	end
end)

-- Fungsi Pindah Lapisan Layer Depan / Belakang
LayerBtn.MouseButton1Click:Connect(function()
	isDepan = not isDepan
	if isDepan then
		screenGui.DisplayOrder = 999 -- Di depan semua UI game bawaan
		LayerBtn.Text = "Layer: Depan (Overlay)"
	else
		screenGui.DisplayOrder = 0 -- Di belakang / Sejajar dengan UI game biasa
		LayerBtn.Text = "Layer: Belakang"
	end
end)

-- Fungsi Mengaktifkan Tombol Automation
ActionBtn.MouseButton1Click:Connect(function()
	actionAktif = not actionAktif
	if actionAktif then
		ActionBtn.BackgroundColor3 = Color3.fromRGB(16, 185, 129) -- Hijau saat aktif
		ActionBtn.Text = "AUTOMATION: ON"
	else
		ActionBtn.BackgroundColor3 = Color3.fromRGB(239, 68, 68) -- Merah saat mati
		ActionBtn.Text = "AUTOMATION: OFF"
	end
end)

-- LOOP UTAMA AUTOMATION (Anti-AFK & Auto-Jump)
-- Fungsi Anti-AFK mencegah kamu disconnect (Error 260) dari game Roblox
player.Idled:Connect(function()
	if actionAktif then
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new(0,0))
	end
end)

-- Fungsi Pendukung (Aksi berulang di dalam game, contoh: Melompat otomatis)
task.spawn(function()
	while true do
		task.wait(0.8) -- Kecepatan aksi lompat otomatis
		if actionAktif and player.Character then
			local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
			if humanoid then 
				humanoid.Jump = true 
			end
		end
	end
end)
