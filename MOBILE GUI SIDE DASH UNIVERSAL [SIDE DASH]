-- ---------------------------------------------------------------------
-- 4. LOGIKA UTAMA: FITUR SIDE DASH
-- ---------------------------------------------------------------------
local Players = game:GetService("Players")
local localPlayer = Players.LocalPlayer
local dashPower = 65
local dashDuration = 0.2
local cooldown = 0.8
local canDash = true

local function performDash(direction)
    local character = localPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    
    if rootPart and canDash then
        canDash = false
        
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(100000, 0, 100000) -- Kunci sumbu Y agar tidak terbang/jatuh
        
        local camera = workspace.CurrentCamera
        if direction == "Left" then
            bodyVelocity.Velocity = -camera.CFrame.RightVector * dashPower
        elseif direction == "Right" then
            bodyVelocity.Velocity = camera.CFrame.RightVector * dashPower
        end
        
        bodyVelocity.Parent = rootPart
        task.wait(dashDuration)
        bodyVelocity:Destroy()
        
        task.wait(cooldown)
        canDash = true
    end
end

-- Sambungkan tombol GUI ke fungsi Dash
DashLeftBtn.MouseButton1Click:Connect(function()
    performDash("Left")
end)

DashRightBtn.MouseButton1Click:Connect(function()
    performDash("Right")
end)

