-- [[ SLIDE DASH MECHANIC ]] --
local function performDash()
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    
    if not humanoid or not rootPart then return end
    if not canDash or isDashing or humanoid.MoveDirection.Magnitude == 0 then return end
    
    canDash = false
    isDashing = true
    statusLabel.Text = "Dashing..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)
    
    -- Ambil arah jalan
    local dashDirection = humanoid.MoveDirection
    
    -- Efek Dorongan (Velocity)
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(100000, 0, 100000) -- Kunci sumbu Y supaya ga terbang
    bodyVelocity.Velocity = dashDirection * DASH_SPEED
    bodyVelocity.Parent = rootPart
    
    -- Efek Slide (Menurunkan badan / HipHeight)
    local originalHipHeight = humanoid.HipHeight
    humanoid.HipHeight = -1.5 
    
    -- Hapus efek setelah durasi selesai
    Debris:AddItem(bodyVelocity, DASH_DURATION)
    task.delay(DASH_DURATION, function()
        humanoid.HipHeight = originalHipHeight
        isDashing = false
    end)
    
    -- Cooldown System
    task.wait(DASH_DURATION)
    local cooldownLeft = DASH_COOLDOWN
    while cooldownLeft > 0 do
        statusLabel.Text = string.format("Cooldown: %.1fs", cooldownLeft)
        statusLabel.TextColor3 = Color3.fromRGB(220, 53, 69)
        task.wait(0.1)
        cooldownLeft = cooldownLeft - 0.1
    end
    
    canDash = true
    statusLabel.Text = "Dash Ready [Q]"
    statusLabel.TextColor3 = Color3.fromRGB(0, 255, 127)
end

-- [[ DETEKSI INPUT ]] --
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end
    if input.KeyCode == DASH_KEY then
        performDash()
    end
end)
