-- [[ LOGIKA SPAM FUNCTION ]] --

local LP = game.Players.LocalPlayer
local spamCarpetActive = false
local spamToolsActive = false

-- Fungsi nyari item Karpet di game (bisa disesuaikan namanya)
local function getCarpet()
    local carpet = LP.Backpack:FindFirstChild("Carpet") or LP.Character:FindFirstChild("Carpet")
    if not carpet then
        -- Cari alternatif nama karpet lain di backpack
        for _, item in pairs(LP.Backpack:GetChildren()) do
            if string.find(string.lower(item.Name), "carpet") or string.find(string.lower(item.Name), "karpet") then
                return item
            end
        end
    end
    return carpet
end

-- Loop Spam Carpet
task.spawn(function()
    while task.wait(0.1) do
        if spamCarpetActive then
            local carpet = getCarpet()
            if carpet and LP.Character and LP.Character:FindFirstChild("Humanoid") then
                -- Memaksa karakter memakai dan melepas karpet dengan cepat (Glitch Terbang)
                LP.Character.Humanoid:EquipTool(carpet)
                task.wait(0.05)
                carpet.Parent = LP.Backpack
                StatusLabel.Text = "Status: Spamming Carpet..."
            else
                StatusLabel.Text = "Status: Karpet tidak ditemukan!"
            end
        end
    end
end)

-- Loop Spam/Drop Semua Tools di Backpack
task.spawn(function()
    while task.wait(0.05) do
        if spamToolsActive then
            if #LP.Backpack:GetChildren() > 0 or (LP.Character and LP.Character:FindFirstChildOfClass("Tool")) then
                StatusLabel.Text = "Status: Spamming/Dropping Tools..."
                
                -- Ambil semua tool ke tangan
                for _, tool in pairs(LP.Backpack:GetChildren()) do
                    if tool:IsA("Tool") then
                        LP.Character.Humanoid:EquipTool(tool)
                        task.wait()
                        -- FE Drop (Jika game mengizinkan CanDrop)
                        tool.Parent = workspace 
                    end
                end
            else
                StatusLabel.Text = "Status: Backpack Kosong!"
            end
        end
    end
end)

-- Kontrol Tombol Aktif/Nonaktif
